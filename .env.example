# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Postgres ---
POSTGRES_DB=pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Pulse ---
PULSE_FAIL_THRESHOLD=3
PULSE_OK_THRESHOLD=2

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/0

# --- Alerts ---
# Shared by Pulse (signs) and catcher (verifies). Any long random string.
PULSE_WEBHOOK_SECRET=change-me
PULSE_ALERT_MAX_ATTEMPTS=5
