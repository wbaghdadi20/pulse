# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# gunicorn worker processes in the api container.
WEB_CONCURRENCY=2
# DEBUG, INFO, WARNING, ERROR or CRITICAL. Logs are JSON, one object per line.
PULSE_LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_DB=pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Login ---
# Signs access tokens. At least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PULSE_JWT_SECRET=change-me-to-at-least-32-random-characters
# Seconds a token is valid after /login.
PULSE_JWT_TTL_SECONDS=3600

# --- Rate limits ---
# Requests per minute from one client address, on the whole API.
PULSE_RATE_LIMIT_PER_MINUTE=60
# The same, on /login and /signup only.
PULSE_AUTH_RATE_LIMIT_PER_MINUTE=5
# Proxies in front of Pulse that add to X-Forwarded-For. 0 = none: ignore the header.
PULSE_NUM_PROXIES=0

# --- Pulse ---
PULSE_FAIL_THRESHOLD=3
PULSE_OK_THRESHOLD=2

# Hosts on private addresses that monitors may still point at: your own targets.
# Everything else on a private or internal address is refused.
PULSE_ALLOWED_PRIVATE_HOSTS=flaky,shop

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/0

# --- Alerts ---
# Shared by Pulse (signs) and catcher (verifies). Any long random string.
PULSE_WEBHOOK_SECRET=change-me
PULSE_ALERT_MAX_ATTEMPTS=5
# Seconds one delivery attempt may take.
PULSE_WEBHOOK_TIMEOUT_S=5

# --- Cache and locks ---
# A different Redis database from the broker's (0).
PULSE_REDIS_URL=redis://redis:6379/1
# Seconds /status is served from the cache. 0 turns the cache off.
PULSE_STATUS_CACHE_SECONDS=15
